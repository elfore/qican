params {
    // 路径参数
    script              = "/mnt/gpfs/Dataset/04.project/Bioinfo/31.Influenza/pipline/v6/script"
    database            = "/mnt/gpfs/Dataset/04.project/Bioinfo/31.Influenza/pipline/v6/database"
    genome              ="/mnt/gpfs/Dataset/04.project/Bioinfo/31.Influenza/pipline/v6/database"

    // 基础工具
    python              = "/mnt/gpfs/Users/wangwenping/software/Venv/python3/bin/python"
    perl                = "/mnt/gpfs/Users/wangning/software/Miniconda/bin/perl"
    Rscript_tree             = "/mnt/gpfs/Users/zhangsijia/local/envs/ggtree/bin/Rscript"
    Rscript_html           ="/mnt/gpfs/Users/wangwenping/software/miniconda3/envs/WES/bin/Rscript"
    Rscript_cov        ="/mnt/gpfs/Users/wangwenping/software/miniconda3/envs/Renv/bin/Rscript"
    java                ="/mnt/gpfs/Users/zhangsijia/local/envs/pangolin/bin/java"

    // 质控
    fastp              ="/mnt/gpfs/Users/wangwenping/software/miniconda3/envs/WES/bin/fastp"
    // 比对
    bwa                 = "/mnt/gpfs/Software/Bioinfo/bwa/bwa"
    samtools            = "/mnt/gpfs/Users/wangwenping/software/miniconda3/bin/samtools"
    bedtools            = "/mnt/gpfs/Users/wangwenping/software/miniconda3/envs/WES/bin/bedtools"

    // 拼接
    spades              = "/mnt/gpfs/Users/wangning/software/Miniconda/envs/spades-4.2.0/bin"
    spades_py           = "${spades}/spades.py"
    spades_python       = "${spades}/python"

    // 注释 / 变异
    blastn              = "/mnt/gpfs/Users/huyangzhirong/02.sofware/ncbi-blast-2.13.0+/bin/blastn"
    freebayes           = "/mnt/gpfs/Users/fanlei/miniconda3/bin/freebayes"
    bcftools            = "/mnt/gpfs/Users/wangning/software/bin/bcftools"
    snpeff              = "/mnt/gpfs/Users/zhangsijia/software/snpEff/snpEff.jar"
    nextclade           = "/mnt/gpfs/Users/wangwenping/software/miniconda3/envs/metagenome/bin/nextclade"

    // 进化
    mafft               = "/mnt/gpfs/Users/zhangsijia/software/miniconda3/envs/gubbins/bin/mafft"
    fasttree            = "/mnt/gpfs/Users/zhangsijia/software/miniconda3/bin/FastTree"
}


process {
    ignore_selector_warnings = true
    executor = 'sge'
    maxForks = 40
    qsub='/opt/sge/bin/linux-x64/qsub'

    clusterOptions = '-S /bin/bash -V -cwd -pe smp 4 -l vf=4G -q RAM -P p_ram'

    withLabel: big_mem {
        clusterOptions = '-S /bin/bash -V -cwd -pe smp 4 -l vf=2G -q RAM -P p_ram'
    }

    withLabel: big_mem_2 {
        clusterOptions = '-S /bin/bash -V -pe smp 10 -l vf=4G -l h=!node03 -q all.q'
    }
}

executor {
    name = 'sge'
    queueSize = 40  // 与maxForks匹配，避免任务堆积
    pollInterval = '10s'  // 缩短任务状态检查间隔
    queueStatInterval = '1m'  // 队列状态检查间隔
}

